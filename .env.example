# ==============================================================================
# ROADSENSE ENVIRONMENT CONFIGURATION
# ==============================================================================
# If Supabase keys are not provided, the application runs automatically in full
# local demo mode with persistent localStorage and rich Bengaluru seed data.

# Supabase Project URL & Anonymous Key (Public Client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Map Tile Provider (Default: OpenStreetMap raster tiles)
# To use Mapbox or Stadia Maps, customize this URL template:
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Routing Provider (Default: Public OSRM routing endpoint)
VITE_OSRM_ROUTER_URL=https://router.project-osrm.org/route/v1/driving/

# Application Environment Mode
VITE_APP_ENV=development
VITE_DEMO_MODE=true

